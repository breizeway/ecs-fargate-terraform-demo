.DS_Store
.idea/
.vscode/

__pycache__/
*.pyc
.pytest_cache/
.venv/

# Local secrets must never be committed; configuration belongs in the environment. https://12factor.net/config
.env
.env.*
!.env.example
*.pem
*.key

# State and plans can contain secrets, so they are never committed (the dependency lock file is). https://opentofu.org/docs/language/state/sensitive-data/
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
tfplan
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
*.tfvars
*.tfvars.json
!*.tfvars.example
.terraformrc
terraform.rc
# Account-specific backend settings; see infra/backend.hcl.example. https://opentofu.org/docs/language/settings/backends/configuration/
backend.hcl
